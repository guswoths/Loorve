rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ 최상위 exams 컬렉션: 본인이 생성한 시험만 접근 허용
    match /exams/{examId} {
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ✅ 마이페이지용 사용자 프로필 문서: 본인만 읽기/쓰기 허용
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      // ✅ progress 서브컬렉션: 본인 학습 진도 읽기/쓰기 허용
      match /progress/{progressId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // ✅ reviewSchedules 서브컬렉션: 본인 복습 일정 읽기/쓰기 허용
      match /reviewSchedules/{scheduleId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // ✅ examResults 컬렉션: userId 필드 기준으로 본인 결과만 접근 허용
    match /examResults/{resultId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

  }
}