rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 본인만 접근 가능한 하위 컬렉션 공통 함수
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidStudyRecord() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.learningDate is number
          && data.examDate is number
          && data.examDate > data.learningDate;
    }

    function isValidScheduleItem() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.reviewDate is number
          && data.status in ['PENDING','COMPLETED','OVERDUE','FINAL_URGENT_REVIEW'];
    }

    // ✅ 신규 추가: progress 유효성 검사 함수
    function isValidProgress() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.keys().hasAll(['examId', 'content']);
    }

    // ✅ 신규 추가: reviewSchedules 유효성 검사 함수
    function isValidReviewSchedule() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.keys().hasAll(['scheduleId', 'reviewDate', 'isCompleted']);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // 복습 블록 (기존)
      match /reviewBlocks/{blockId} {
        allow read, write: if isOwner(uid);
      }

      // 학습기록 (기존)
      match /studyRecords/{recordId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidStudyRecord();
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(uid);
      }

      // 복습 일정 항목 (기존)
      match /reviewScheduleItems/{itemId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidScheduleItem();
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid
            && (resource.data.status != 'COMPLETED'
                || request.resource.data.completedAt == resource.data.completedAt);
        allow delete: if isOwner(uid);
      }

      // ✅ 신규 추가: 학습 진도
      match /progress/{progressId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidProgress();
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid; // uid 변경 불가
        allow delete: if isOwner(uid);
      }

      // ✅ 신규 추가: 복습 일정
      match /reviewSchedules/{scheduleId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidReviewSchedule();
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid; // uid 변경 불가
        allow delete: if isOwner(uid);
      }
    }
  }
}