rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 본인만 접근 가능한 하위 컬렉션 공통 함수
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidStudyRecord() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.blockId is string
          && data.learningDate is number
          && data.examDate is number
          && data.examDate > data.learningDate;
    }

    function isValidScheduleItem() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.reviewDate is number
          && data.status in [
            'PENDING','COMPLETED','OVERDUE','FINAL_URGENT_REVIEW',
            'CRAM_MODE_REQUIRED','OVERLOADED_UNRESOLVED'
          ];
    }

    // ✅ 신규 추가: progress 유효성 검사 함수
    function isValidProgress() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.keys().hasAll(['examId', 'content']);
    }

    // ✅ 신규 추가: reviewSchedules 유효성 검사 함수
    function isValidReviewSchedule() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
          && data.keys().hasAll(['scheduleId', 'reviewDate', 'isCompleted'])
          && data.reviewDate is number
          && data.isCompleted is bool;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // 복습 블록 (기존)
      match /reviewBlocks/{blockId} {
        allow read, write: if isOwner(uid);
      }

      // 학습기록 (기존)
      match /studyRecords/{recordId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
            && isValidStudyRecord()
            && get(/databases/$(database)/documents/users/$(uid)/reviewBlocks/$(request.resource.data.blockId)).data.uid == uid;
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(uid);
      }

      // 복습 일정 항목 (기존)
      match /reviewScheduleItems/{itemId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
            && isValidScheduleItem()
            && getAfter(/databases/$(database)/documents/users/$(uid)/studyRecords/$(request.resource.data.studyRecordId)).data.uid == uid;
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid
            && (resource.data.status == 'COMPLETED'
                ? request.resource.data.completedAt == resource.data.completedAt
                : true);
        allow delete: if isOwner(uid);
      }

      // ✅ 신규 추가: 학습 진도
      match /progress/{progressId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidProgress();
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid; // uid 변경 불가
        allow delete: if isOwner(uid);
      }

      // ✅ 신규 추가: 복습 일정
      match /reviewSchedules/{scheduleId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidReviewSchedule();
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid; // uid 변경 불가
        allow delete: if isOwner(uid);
      }

      match /reviewNotificationOutbox/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.reviewId is string
            && request.resource.data.scheduledDate is string;
        allow update: if isOwner(uid)
            && request.resource.data.uid == resource.data.uid;
      }
    }

    match /exams/{examId} {
      allow read: if isOwner(resource.data.createdBy);
      allow create: if isOwner(request.resource.data.createdBy);
      allow update: if isOwner(resource.data.createdBy)
          && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOwner(resource.data.createdBy);
    }
  }
}